variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY_1__

storage:
  directories:
    - path: /opt/k3s
      mode: 0755

    - path: /etc/rancher/k3s
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          __HOSTNAME__

    - path: /etc/rancher/k3s/token
      mode: 0600
      user:
        name: root
      group:
        name: root
      contents:
        inline: __K3S_TOKEN__

    - path: /opt/k3s/install-agent.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail

          log() {
            echo ""
            echo "==> [k3s-bootstrap] $1"
          }

          if [ -f /etc/k3s-bootstrap-complete ]; then
            log "Bootstrap already complete; skipping."
            exit 0
          fi

          log "Starting k3s agent bootstrap"

          log "Checking for open-vm-tools"
          if ! rpm -q open-vm-tools &>/dev/null; then
            log "Layering open-vm-tools via rpm-ostree (effective after reboot)"
            rpm-ostree install -y open-vm-tools
          else
            log "open-vm-tools already present"
          fi

          log "Installing k3s agent __K3S_VERSION__, joining __CONTROL_PLANE_IP__"
          curl -sfL https://get.k3s.io | \
            INSTALL_K3S_VERSION="__K3S_VERSION__" \
            K3S_URL="https://__CONTROL_PLANE_IP__:6443" \
            INSTALL_K3S_EXEC="agent --token-file=/etc/rancher/k3s/token" \
            sh -

          log "Ensuring the k3s-agent service is enabled and started"
          systemctl enable --now k3s-agent

          log "Waiting for the k3s-agent service to become active"
          K3S_UP=false
          for i in $(seq 1 30); do
            if systemctl is-active --quiet k3s-agent; then
              log "k3s-agent is active (after ~$((i * 2))s)"
              K3S_UP=true
              break
            fi
            echo "    still waiting on k3s-agent... (${i}/30)"
            sleep 2
          done

          if [ "${K3S_UP}" != true ]; then
            log "ERROR: k3s-agent did not become active after 60s. Last 50 journal lines:"
            journalctl -u k3s-agent --no-pager -n 50 || true
            log "Not marking bootstrap complete or rebooting. Fix the issue above,"
            log "then either re-run this service or reboot to retry: systemctl restart k3s-agent-install.service"
            exit 1
          fi

          log "Marking bootstrap complete"
          touch /etc/k3s-bootstrap-complete

          log "Bootstrap finished successfully; rebooting to finalize open-vm-tools layer"
          systemctl reboot

systemd:
  units:
    - name: k3s-agent-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Bootstrap k3s agent (idempotent, one-time)
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/etc/k3s-bootstrap-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        StandardError=journal+console
        ExecStart=/opt/k3s/install-agent.sh

        [Install]
        WantedBy=multi-user.target
