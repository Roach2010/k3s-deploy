variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY_1__

storage:
  directories:
    - path: /opt/k3s
      mode: 0755

    - path: /etc/rancher/k3s
      mode: 0755

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          __HOSTNAME__

    - path: /etc/rancher/k3s/token
      mode: 0600
      user:
        name: root
      group:
        name: root
      contents:
        inline: __K3S_TOKEN__

    - path: /opt/k3s/install-server.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail

          log() {
            echo ""
            echo "==> [k3s-bootstrap] $1"
          }

          # Idempotency guard - do nothing if already bootstrapped
          if [ -f /etc/k3s-bootstrap-complete ]; then
            log "Bootstrap already complete; skipping."
            exit 0
          fi

          log "Starting k3s control-plane bootstrap"

          log "Checking for open-vm-tools"
          if ! rpm -q open-vm-tools &>/dev/null; then
            log "Layering open-vm-tools via rpm-ostree (effective after reboot)"
            rpm-ostree install -y open-vm-tools
          else
            log "open-vm-tools already present"
          fi

          log "Installing k3s server __K3S_VERSION__ (mode: __CP_MODE__)"
          curl -sfL https://get.k3s.io | \
            INSTALL_K3S_VERSION="__K3S_VERSION__" \
            INSTALL_K3S_EXEC="server \
              __TLS_SAN_FLAGS__ \
              --write-kubeconfig-mode=600 \
              --cluster-cidr=__CLUSTER_CIDR__ \
              --service-cidr=__SERVICE_CIDR__ \
              --token-file=/etc/rancher/k3s/token \
              __CP_EXTRA_FLAG__" \
            sh -

          log "Ensuring the k3s service is enabled and started"
          systemctl enable --now k3s

          log "Waiting for the k3s service to become active"
          K3S_UP=false
          for i in $(seq 1 30); do
            if systemctl is-active --quiet k3s; then
              log "k3s is active (after ~$((i * 2))s)"
              K3S_UP=true
              break
            fi
            echo "    still waiting on k3s... (${i}/30)"
            sleep 2
          done

          if [ "${K3S_UP}" != true ]; then
            log "ERROR: k3s did not become active after 60s. Last 50 journal lines:"
            journalctl -u k3s --no-pager -n 50 || true
            log "Not marking bootstrap complete or rebooting. Fix the issue above,"
            log "then either re-run this service or reboot to retry: systemctl restart k3s-server-install.service"
            exit 1
          fi

          log "Waiting for kubeconfig to be written"
          for i in $(seq 1 30); do
            [ -s /etc/rancher/k3s/k3s.yaml ] && break
            echo "    still waiting on kubeconfig... (${i}/30)"
            sleep 2
          done

          if [ ! -s /etc/rancher/k3s/k3s.yaml ]; then
            log "ERROR: /etc/rancher/k3s/k3s.yaml was not created after k3s became active."
            exit 1
          fi

          log "Creating core user's kubeconfig at /home/core/.kube/config (server: __KUBE_API_HOSTNAME__)"
          # This is a one-time copy, not a patch of the live file - k3s
          # regenerates /etc/rancher/k3s/k3s.yaml (with server: 127.0.0.1)
          # on every service start, but never touches this copy again.
          mkdir -p /home/core/.kube
          cp /etc/rancher/k3s/k3s.yaml /home/core/.kube/config
          sed -i -E "s#^(\s*server:\s*).*#\1https://__KUBE_API_HOSTNAME__:6443#" /home/core/.kube/config
          chown -R core:core /home/core/.kube
          chmod 0700 /home/core/.kube
          chmod 0600 /home/core/.kube/config

          log "Marking bootstrap complete"
          touch /etc/k3s-bootstrap-complete

          log "Bootstrap finished successfully; rebooting to finalize open-vm-tools layer"
          systemctl reboot

systemd:
  units:
    - name: k3s-server-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Bootstrap k3s server (idempotent, one-time)
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/etc/k3s-bootstrap-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        StandardError=journal+console
        ExecStart=/opt/k3s/install-server.sh

        [Install]
        WantedBy=multi-user.target
