variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY_1__

storage:
  directories:
    - path: /opt/k3s
      mode: 0755

    - path: /etc/rancher/k3s
      mode: 0755

  files:
    # Identical on all servers: K3s does not replicate its manifests directory.
    # Use the local API so leader election never depends on the VIP it manages.
    - path: /var/lib/rancher/k3s/server/manifests/kube-vip.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: v1
          kind: ServiceAccount
          metadata:
            name: kube-vip
            namespace: kube-system
          ---
          apiVersion: rbac.authorization.k8s.io/v1
          kind: Role
          metadata:
            name: kube-vip
            namespace: kube-system
          rules:
            - apiGroups: ["coordination.k8s.io"]
              resources: ["leases"]
              verbs: ["get", "list", "watch", "create", "update", "patch"]
          ---
          apiVersion: rbac.authorization.k8s.io/v1
          kind: RoleBinding
          metadata:
            name: kube-vip
            namespace: kube-system
          roleRef:
            apiGroup: rbac.authorization.k8s.io
            kind: Role
            name: kube-vip
          subjects:
            - kind: ServiceAccount
              name: kube-vip
              namespace: kube-system
          ---
          apiVersion: apps/v1
          kind: DaemonSet
          metadata:
            name: kube-vip-ds
            namespace: kube-system
          spec:
            selector:
              matchLabels:
                app: kube-vip
            template:
              metadata:
                labels:
                  app: kube-vip
              spec:
                serviceAccountName: kube-vip
                hostNetwork: true
                dnsPolicy: ClusterFirstWithHostNet
                priorityClassName: system-node-critical
                nodeSelector:
                  node-role.kubernetes.io/control-plane: "true"
                tolerations:
                  - operator: Exists
                    effect: NoSchedule
                  - operator: Exists
                    effect: NoExecute
                containers:
                  - name: kube-vip
                    image: ghcr.io/kube-vip/kube-vip:__KUBE_VIP_VERSION__
                    imagePullPolicy: IfNotPresent
                    args: ["manager"]
                    securityContext:
                      capabilities:
                        add: ["NET_ADMIN", "NET_RAW"]
                    env:
                      - name: KUBERNETES_SERVICE_HOST
                        value: "127.0.0.1"
                      - name: KUBERNETES_SERVICE_PORT
                        value: "6443"
                      - name: vip_arp
                        value: "true"
                      - name: vip_interface
                        value: "__KUBE_VIP_INTERFACE__"
                      - name: vip_subnet
                        value: "32"
                      - name: address
                        value: "__KUBE_VIP__"
                      - name: port
                        value: "6443"
                      - name: cp_enable
                        value: "true"
                      - name: cp_namespace
                        value: "kube-system"
                      - name: svc_enable
                        value: "false"
                      - name: vip_leaderelection
                        value: "true"
                      - name: vip_leaseduration
                        value: "15"
                      - name: vip_renewdeadline
                        value: "10"
                      - name: vip_retryperiod
                        value: "2"
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          __HOSTNAME__

    - path: /etc/rancher/k3s/token
      mode: 0600
      user:
        name: root
      group:
        name: root
      contents:
        inline: __K3S_TOKEN__

    - path: /opt/k3s/install-server.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail

          log() {
            echo ""
            echo "==> [k3s-bootstrap] $1"
          }

          # Idempotency guard - do nothing if already bootstrapped
          if [ -f /etc/k3s-bootstrap-complete ]; then
            log "Bootstrap already complete; skipping."
            exit 0
          fi

          log "Starting k3s control-plane bootstrap"

          if ! ip link show dev "__KUBE_VIP_INTERFACE__" >/dev/null 2>&1; then
            log "ERROR: kube-vip interface __KUBE_VIP_INTERFACE__ does not exist."
            ip -br link
            exit 1
          fi

          log "Checking for open-vm-tools"
          if ! rpm -q open-vm-tools &>/dev/null; then
            log "Layering open-vm-tools via rpm-ostree (effective after reboot)"
            rpm-ostree install -y open-vm-tools
          else
            log "open-vm-tools already present"
          fi

          log "Installing k3s server __K3S_VERSION__ (mode: __CP_MODE__)"
          curl -sfL https://get.k3s.io | \
            INSTALL_K3S_VERSION="__K3S_VERSION__" \
            INSTALL_K3S_EXEC="server \
              __TLS_SAN_FLAGS__ \
              --write-kubeconfig-mode=600 \
              --cluster-cidr=__CLUSTER_CIDR__ \
              --service-cidr=__SERVICE_CIDR__ \
              --token-file=/etc/rancher/k3s/token \
              __CP_EXTRA_FLAG__" \
            sh -

          log "Ensuring the k3s service is enabled and started"
          systemctl enable --now k3s

          log "Waiting for the k3s service to become active"
          K3S_UP=false
          for i in $(seq 1 30); do
            if systemctl is-active --quiet k3s; then
              log "k3s is active (after ~$((i * 2))s)"
              K3S_UP=true
              break
            fi
            echo "    still waiting on k3s... (${i}/30)"
            sleep 2
          done

          if [ "${K3S_UP}" != true ]; then
            log "ERROR: k3s did not become active after 60s. Last 50 journal lines:"
            journalctl -u k3s --no-pager -n 50 || true
            log "Not marking bootstrap complete or rebooting. Fix the issue above,"
            log "then either re-run this service or reboot to retry: systemctl restart k3s-server-install.service"
            exit 1
          fi

          log "Waiting for kubeconfig to be written"
          for i in $(seq 1 30); do
            [ -s /etc/rancher/k3s/k3s.yaml ] && break
            echo "    still waiting on kubeconfig... (${i}/30)"
            sleep 2
          done

          if [ ! -s /etc/rancher/k3s/k3s.yaml ]; then
            log "ERROR: /etc/rancher/k3s/k3s.yaml was not created after k3s became active."
            exit 1
          fi

          log "Creating core user's kubeconfig at /home/core/.kube/config (server: __KUBE_API_HOSTNAME__)"
          # This is a one-time copy, not a patch of the live file - k3s
          # regenerates /etc/rancher/k3s/k3s.yaml (with server: 127.0.0.1)
          # on every service start, but never touches this copy again.
          mkdir -p /home/core/.kube
          cp /etc/rancher/k3s/k3s.yaml /home/core/.kube/config
          sed -i -E "s#^(\s*server:\s*).*#\1https://__KUBE_API_HOSTNAME__:6443#" /home/core/.kube/config
          chown -R core:core /home/core/.kube
          chmod 0700 /home/core/.kube
          chmod 0600 /home/core/.kube/config

          if [ "__INSTALL_CSI_DRIVER__" = "true" ]; then
            log "Installing csi-driver-nfs __NFS_CSI_DRIVER_VERSION__"
            export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
            export PATH="/usr/local/bin:${PATH}"

            log "Waiting for the Kubernetes API to accept requests"
            API_UP=false
            for i in $(seq 1 30); do
              if kubectl get --raw=/readyz &>/dev/null; then
                API_UP=true
                break
              fi
              echo "    still waiting on the API server... (${i}/30)"
              sleep 2
            done

            CSI_NFS_INSTALL_URL="https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/__NFS_CSI_DRIVER_VERSION__/deploy/install-driver.sh"
            if [ "${API_UP}" = true ]; then
              if curl -skSL "${CSI_NFS_INSTALL_URL}" | bash -s __NFS_CSI_DRIVER_VERSION__ --; then
                log "csi-driver-nfs installed"
              else
                log "WARNING: csi-driver-nfs install failed. The k3s cluster itself is fine -"
                log "retry manually later: curl -skSL ${CSI_NFS_INSTALL_URL} | bash -s __NFS_CSI_DRIVER_VERSION__ --"
              fi
            else
              log "WARNING: API server did not become ready in time; skipping csi-driver-nfs install."
              log "Install it manually later: curl -skSL ${CSI_NFS_INSTALL_URL} | bash -s __NFS_CSI_DRIVER_VERSION__ --"
            fi
          else
            log "Skipping csi-driver-nfs install (additional HA node joining an existing cluster)"
          fi

          log "Marking bootstrap complete"
          touch /etc/k3s-bootstrap-complete

          log "Bootstrap finished successfully; rebooting to finalize open-vm-tools layer"
          systemctl reboot

systemd:
  units:
    - name: k3s-server-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Bootstrap k3s server (idempotent, one-time)
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/etc/k3s-bootstrap-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        StandardError=journal+console
        ExecStart=/opt/k3s/install-server.sh

        [Install]
        WantedBy=multi-user.target
