---
apiVersion: v1
kind: ConfigMap
metadata:
  name: emby-proxy
  namespace: {{ emby_namespace | to_json }}
data:
  nginx.conf: {{ lookup('template', 'proxy.conf.j2') | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: emby-headless
  namespace: {{ emby_namespace | to_json }}
spec:
  clusterIP: None
  selector:
    app: emby
  ports:
    - name: http
      port: 8096
      targetPort: http
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: emby
  namespace: {{ emby_namespace | to_json }}
spec:
  replicas: 1
  serviceName: emby-headless
  updateStrategy:
    type: RollingUpdate
  selector:
    matchLabels:
      app: emby
  template:
    metadata:
      annotations:
        checksum/proxy: {{ lookup('template', 'proxy.conf.j2') | hash('sha256') | to_json }}
      labels:
        app: emby
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 120
      containers:
        - name: emby
          image: {{ (emby_image ~ ':' ~ emby_version) | to_json }}
          imagePullPolicy: IfNotPresent
          env:
            - name: UID
              value: {{ emby_uid | string | to_json }}
            - name: GID
              value: {{ emby_gid | string | to_json }}
            - name: GIDLIST
              value: {{ emby_gid | string | to_json }}
          ports:
            - name: http
              containerPort: 8096
          startupProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: 10
          volumeMounts:
            - name: config
              mountPath: /config
            - name: media
              mountPath: /media
              readOnly: {{ emby_media_read_only | bool | to_json }}
            - name: transcode
              mountPath: /transcode
        - name: https-proxy
          image: {{ (emby_proxy_image ~ ':' ~ emby_proxy_version) | to_json }}
          imagePullPolicy: IfNotPresent
          command: [nginx, -c, /proxy/nginx.conf, -g, "daemon off;"]
          ports:
            - name: https
              containerPort: 8443
          readinessProbe:
            httpGet:
              scheme: HTTPS
              path: /healthz
              port: https
            periodSeconds: 5
          livenessProbe:
            httpGet:
              scheme: HTTPS
              path: /healthz
              port: https
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: proxy
              mountPath: /proxy
              readOnly: true
            - name: tls
              mountPath: /tls
              readOnly: true
      volumes:
        - name: proxy
          configMap:
            name: emby-proxy
        - name: tls
          secret:
            secretName: emby-tls
        - name: config
          persistentVolumeClaim:
            claimName: {{ emby_config_claim | to_json }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ emby_media_claim | to_json }}
        - name: transcode
          emptyDir:
            medium: Memory
            sizeLimit: {{ emby_transcode_size | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: emby
  namespace: {{ emby_namespace | to_json }}
  labels:
    app: emby
  annotations:
    metallb.io/address-pool: emby
    metallb.io/loadBalancerIPs: {{ emby_service_ip | to_json }}
spec:
  type: LoadBalancer
  loadBalancerClass: metallb.io/metallb
  externalTrafficPolicy: Local
  selector:
    app: emby
  ports:
    - name: https
      port: 443
      targetPort: https
