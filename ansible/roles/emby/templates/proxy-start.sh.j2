#!/bin/sh
set -eu
fingerprint() { sha256sum /tls/tls.crt /tls/tls.key; }
previous="$(fingerprint)"
nginx -t -c /proxy/nginx.conf
nginx -c /proxy/nginx.conf -g 'daemon off;' &
proxy_pid=$!
stop() {
    kill -QUIT "$proxy_pid" 2>/dev/null || true
    wait "$proxy_pid" || true
    exit 0
}
trap stop TERM INT
while kill -0 "$proxy_pid" 2>/dev/null; do
    sleep 10 &
    wait $! || true
    current="$(fingerprint)"
    if [ "$current" != "$previous" ]; then
        if nginx -t -c /proxy/nginx.conf; then
            kill -HUP "$proxy_pid"
            previous="$current"
        fi
    fi
done
wait "$proxy_pid"
