---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: emby
  namespace: metallb-system
spec:
  addresses: [{{ (emby_service_ip ~ '/32') | to_json }}]
  autoAssign: false
  serviceAllocation:
    namespaces: [{{ emby_namespace | to_json }}]
    serviceSelectors:
      - matchLabels:
          app: emby
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: emby
  namespace: metallb-system
spec:
  ipAddressPools: [emby]
  nodeSelectors:
    - matchExpressions:
        - key: node-role.kubernetes.io/control-plane
          operator: DoesNotExist
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: emby-tls
  namespace: {{ emby_namespace | to_json }}
spec:
  secretName: emby-tls
  dnsNames: [{{ emby_hostname | to_json }}]
  issuerRef:
    name: {{ emby_cluster_issuer | to_json }}
    kind: ClusterIssuer
