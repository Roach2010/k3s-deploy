---
server_url: {{ ('https://' ~ headscale_hostname) | to_json }}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false
trusted_proxies: []

noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

disable_check_updates: true
node:
  expiry: {{ headscale_node_expiry | to_json }}
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

# NGINX in the same pod terminates TLS using the cert-manager certificate.
tls_letsencrypt_hostname: ""
tls_cert_path: ""
tls_key_path: ""
log:
  level: info
  format: text
policy:
  mode: file
  path: /etc/headscale/policy.json
dns:
  magic_dns: true
  base_domain: {{ headscale_magic_dns_domain | to_json }}
  override_local_dns: {{ headscale_dns_override_local | bool | to_json }}
  nameservers:
    global: {{ headscale_dns_nameservers | to_json }}
    split: {{ headscale_dns_split | to_json }}
  search_domains: []
  extra_records: []
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"
logtail:
  enabled: false
