# Copy this file to deploy.env and fill in real values.
# deploy.env itself is gitignored (see gitignore.snippet) - never commit it.

# --- vCenter connection ---
GOVC_URL='nimdavcsa.roach'
GOVC_USERNAME='username'
GOVC_PASSWORD='password'
GOVC_INSECURE='true'

# --- vSphere placement ---
DS_CLUSTER='datastore-cluster-name'
NETWORK='portgroup'

# FCOS_STREAM: which Fedora CoreOS release stream to pull the latest
# VMware OVA from (stable, testing, or next). Ignored if FCOS_OVA is set.
FCOS_STREAM='stable'

# FCOS_OVA: optional. Leave blank to auto-download the latest OVA for
# FCOS_STREAM into ./ova (verified against its published sha256 and
# skipped on re-runs if already current). Set this to a local file path
# to pin a specific OVA instead of always using the latest.
FCOS_OVA=''

# Inventory path of the VM folder to import into, e.g. /Datacenter/vm/k3s
VM_FOLDER='/datastore/vm/folder'

# --- Hostname / DNS ---
# Each VM's hostname is set to <vm-name-arg>.<DOMAIN_SUFFIX>, e.g.
# deploying "k3s-cp1" with DOMAIN_SUFFIX='cluster.local' below sets
# the hostname to k3s-cp1.cluster.local. No leading dot.
DOMAIN_SUFFIX='cluster.local'

# --- Ignition / k3s values ---
SSH_PUBLIC_KEY_1='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@yourhost'
K3S_TOKEN='K10f8e2c9a1b4d6e::server:9f3c7a1e5b2d4c6a'
CONTROL_PLANE_IP='192.168.60.10'
K3S_VERSION='v1.30.4+k3s1'
CLUSTER_CIDR='10.42.0.0/16'
SERVICE_CIDR='10.43.0.0/16'

# Optional. Extra TLS SAN entries for the control-plane's certificate,
# beyond CONTROL_PLANE_IP itself - comma-separated, e.g. a FQDN:
# EXTRA_TLS_SAN='k3s.roach.lan'
# Leave unset/empty for just CONTROL_PLANE_IP.
EXTRA_TLS_SAN=''
