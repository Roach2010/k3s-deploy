# Copy this file to deploy.env and fill in real values.
# deploy.env itself is gitignored (see .gitignore) - never commit it.

# --- vCenter connection ---
GOVC_URL='vcenter.cluster.local'
GOVC_USERNAME='username'
GOVC_PASSWORD='password'
GOVC_INSECURE='true'

# --- vSphere placement ---
DS_CLUSTER='datastore-cluster'
NETWORK='portgroup'

# FCOS_STREAM: which Fedora CoreOS release stream to pull the latest
# VMware OVA from (stable, testing, or next). Ignored if FCOS_OVA is set.
FCOS_STREAM='stable'

# FCOS_OVA: optional. Leave blank to auto-download the latest OVA for
# FCOS_STREAM into ./ova (verified against its published sha256 and
# skipped on re-runs if already current). Set this to a local file path
# to pin a specific OVA instead of always using the latest.
FCOS_OVA=''

# Inventory path of the VM folder to import into, e.g. /Datacenter/vm/k3s
VM_FOLDER='/datastore/vm/folder'

# --- Hostname / DNS ---
# Each VM's hostname is set to <vm-name-arg>.<DOMAIN_SUFFIX>, e.g.
# deploying "k3s-cp1" with DOMAIN_SUFFIX='cluster.local' below sets
# the hostname to k3s-cp1.cluster.local. No leading dot.
DOMAIN_SUFFIX='cluster.local'

# --- Ignition / k3s values ---
SSH_PUBLIC_KEY_1='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@yourhost'
K3S_TOKEN='K10f8e2c9a1b4d6e::server:9f3c7a1e5b2d4c6a'
K3S_VERSION='v1.36.4+k3s1'
CLUSTER_CIDR='10.42.0.0/16'
SERVICE_CIDR='10.43.0.0/16'

# --- Control-plane nodes (HA) ---
# An explicit IP and hostname for node 1, plus the IP and hostname
# for nodes 2 and 3. DOMAIN_SUFFIX (above) gets appended to each
# *_NAME automatically, same as it does for whatever hostname you
# pass as this script's argument - so CP1_NAME='k3s-cp1' below
# becomes k3s-cp1.cluster.local. All three IPs and all three resulting
# DNS names are included on EVERY control-plane node's TLS certificate,
# regardless of which one is currently being deployed - so fill these in
# before nodes 2/3 even exist yet. Each *_NAME should match whatever
# hostname you'll actually give that node when you deploy it.
CP1_IP='192.168.60.11'
CP1_NAME='k3s-cp1'
CP2_IP='192.168.60.12'
CP2_NAME='k3s-cp2'
CP3_IP='192.168.60.13'
CP3_NAME='k3s-cp3'

# kube-vip ARP failover. Reserve this unused IP outside the DHCP pool.
# All control-plane NICs must share its VLAN/subnet and interface name.
KUBE_VIP='192.168.60.10'
# Verify the VM NIC name with `ip -br link`; ens192 is only an example.
KUBE_VIP_INTERFACE='ens192'
KUBE_VIP_VERSION='v1.2.4'

# Shared Kubernetes API DNS name. Create ONE A record pointing to KUBE_VIP.
# Used as: the "server:" address in the core user's
# kubeconfig (/home/core/.kube/config), the join target worker nodes use,
# and it's automatically added to the control-plane's TLS SAN list.
# Needs to actually resolve via your own DNS server; nothing in this
# toolkit sets that up.
KUBE_API_HOSTNAME='k3s.local.cluster'

# Optional. Extra TLS SAN entries for the control-plane's certificate,
# beyond the CP IPs/DNS names and KUBE_API_HOSTNAME above - comma-separated,
# e.g. another FQDN. Leave unset/empty if you don't need any.
EXTRA_TLS_SAN=''

# --- NFS storage (csi-driver-nfs) ---
# Version tag of kubernetes-csi/csi-driver-nfs to install on the cluster
# (https://github.com/kubernetes-csi/csi-driver-nfs/releases). Only runs
# on the node that creates the cluster (single-node, or --cluster-init) -
# --join nodes skip this. This only installs the driver itself - you
# still need to create a StorageClass pointing at your actual NFS
# server; see the README.
NFS_CSI_DRIVER_VERSION='v4.13.0'
